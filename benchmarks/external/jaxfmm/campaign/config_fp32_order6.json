{
  "campaign": "fp32_order6_point_lattice",
  "description": "First jaxFMM GPU campaign, FP32. Point-target comparison on the cubic lattice with identical point targets: jaxFMM KIFMM p=4/6/8 against dip-fmm orders 6 and 10, paired by achieved accuracy (KIFMM p=6 carries 152 equivalent charges per box, dip-fmm order 6 carries 49 spherical coefficients). Finite companions, never part of a point-target ratio: touching unit cubes (prism sources and targets) on the same lattice, and face-touching Kuhn tetrahedra (six per cell) on a conforming mesh, both dip-fmm only in this campaign.",
  "spacing": 1.0,
  "grids": [10, 16, 20, 25, 32, 40, 50, 64, 80, 100, 128],
  "state": "random",
  "sample_targets": 512,
  "protocol": {"warmups": 3, "samples": 5, "evaluations": 5},
  "jaxfmm": {
    "engines": ["kifmm"],
    "arms": [
      {"p": 4, "N_max": [64, 128, 256], "role": "point_target", "dof_per_box": 56},
      {"p": 6, "N_max": [64, 128, 256], "role": "point_target", "dof_per_box": 152},
      {"p": 8, "N_max": [64], "role": "point_target", "dof_per_box": 296}
    ],
    "environment": {}
  },
  "dipfmm": {
    "precision": "float32",
    "backend": "cuda_full",
    "depths": null,
    "arms": [
      {"geometry": "lattice", "source": "point", "target": "point", "order": 6,
       "role": "point_target", "dof_per_box": 49},
      {"geometry": "lattice", "source": "point", "target": "point", "order": 10,
       "role": "point_target", "dof_per_box": 121},
      {"geometry": "lattice", "source": "body", "target": "body", "order": 6, "body_fill": 1.0,
       "max_occupancy": 1024, "role": "finite_companion", "dof_per_box": 49},
      {"geometry": "kuhn_mesh", "source": "body", "target": "body", "order": 6,
       "grids": [6, 8, 10, 12, 16, 20, 25, 32, 40, 50, 64],
       "max_occupancy": 1024, "role": "finite_companion", "dof_per_box": 49}
    ]
  }
}
