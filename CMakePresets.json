{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cuda",
      "displayName": "Manual CUDA validation build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cuda",
      "environment": {
        "NVCC_PREPEND_FLAGS": "",
        "CPATH": "",
        "CPLUS_INCLUDE_PATH": "",
        "CXXFLAGS": ""
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "$env{CONDA_PREFIX}",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CUDA_HOST_COMPILER": "g++",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CDFMM_ENABLE_CUDA": "ON",
        "CDFMM_INSTALL_PYTHON_TO_ENV": "ON",
        "CDFMM_BUILD_TESTS": "ON",
        "CDFMM_BUILD_EXAMPLES": "OFF",
        "CDFMM_BUILD_PYTHON": "ON",
        "CDFMM_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "notebooks",
      "displayName": "CUDA, oneMKL, and installed Python notebook build",
      "inherits": "cuda",
      "binaryDir": "${sourceDir}/build-notebooks",
      "cacheVariables": {
        "CDFMM_ENABLE_MKL": "ON",
        "MKL_DIR": "$env{CONDA_PREFIX}/lib/cmake/mkl",
        "MKL_INTERFACE": "lp64",
        "MKL_THREADING": "gnu_thread"
      }
    },
    {
      "name": "magtense",
      "displayName": "CUDA, oneMKL, and portable CPU MagTense comparison build",
      "inherits": "notebooks",
      "binaryDir": "${sourceDir}/build-magtense",
      "cacheVariables": {
        "CDFMM_INSTALL_PYTHON_TO_ENV": "ON",
        "CDFMM_BUILD_TESTS": "ON",
        "CDFMM_BUILD_BENCHMARKS": "OFF",
        "CDFMM_ENABLE_OPENMP": "OFF",
        "MKL_THREADING": "intel_thread"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CDFMM_BUILD_TESTS": "ON",
        "CDFMM_BUILD_EXAMPLES": "ON",
        "CDFMM_BUILD_PYTHON": "ON",
        "CDFMM_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "C++ release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CDFMM_BUILD_TESTS": "OFF",
        "CDFMM_BUILD_EXAMPLES": "ON",
        "CDFMM_BUILD_PYTHON": "OFF",
        "CDFMM_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Benchmark build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CDFMM_BUILD_TESTS": "OFF",
        "CDFMM_BUILD_EXAMPLES": "OFF",
        "CDFMM_BUILD_PYTHON": "OFF",
        "CDFMM_BUILD_BENCHMARKS": "ON",
        "CDFMM_ENABLE_OPENMP": "ON",
        "CDFMM_ENABLE_LTO": "ON",
        "CMAKE_CXX_COMPILER": "icpx"
      }
    },
    {
      "name": "benchmark-mkl",
      "displayName": "Benchmark build with oneMKL",
      "inherits": "benchmark",
      "binaryDir": "${sourceDir}/build-bench-mkl",
      "cacheVariables": {
        "CDFMM_ENABLE_MKL": "ON",
        "MKL_DIR": "$env{CONDA_PREFIX}/lib/cmake/mkl"
      }
    },
    {
      "name": "benchmark-all",
      "displayName": "Combined CPU, CUDA, and oneMKL benchmark build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-bench-all",
      "environment": {
        "NVCC_PREPEND_FLAGS": ""
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CUDA_HOST_COMPILER": "g++",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CDFMM_BUILD_TESTS": "OFF",
        "CDFMM_BUILD_EXAMPLES": "OFF",
        "CDFMM_BUILD_PYTHON": "OFF",
        "CDFMM_BUILD_BENCHMARKS": "ON",
        "CDFMM_ENABLE_OPENMP": "ON",
        "CDFMM_ENABLE_CUDA": "ON",
        "CDFMM_ENABLE_MKL": "ON",
        "MKL_DIR": "$env{CONDA_PREFIX}/lib/cmake/mkl",
        "MKL_INTERFACE": "lp64",
        "MKL_THREADING": "gnu_thread"
      }
    },
    {
      "name": "profile-all",
      "displayName": "Combined CUDA, oneMKL, and NVTX profiling build",
      "inherits": "benchmark-all",
      "binaryDir": "${sourceDir}/build-profile-all",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CDFMM_ENABLE_PROFILING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cuda",
      "configurePreset": "cuda",
      "targets": ["install"]
    },
    {
      "name": "notebooks",
      "configurePreset": "notebooks",
      "targets": ["install"]
    },
    {
      "name": "magtense",
      "configurePreset": "magtense",
      "targets": ["install"]
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark"
    },
    {
      "name": "benchmark-mkl",
      "configurePreset": "benchmark-mkl"
    },
    {
      "name": "benchmark-all",
      "configurePreset": "benchmark-all"
    },
    {
      "name": "profile-all",
      "configurePreset": "profile-all"
    }
  ],
  "testPresets": [
    {
      "name": "cuda",
      "configurePreset": "cuda",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "notebooks",
      "configurePreset": "notebooks",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "magtense",
      "configurePreset": "magtense",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
